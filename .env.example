POSTGRES_DB=mailings
POSTGRES_USER=mailings
# Local-only value. A non-empty secret is required when DJANGO_DEBUG=0.
POSTGRES_PASSWORD=mailings-local
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_SECRET_KEY is required when DJANGO_DEBUG=0.
# Enable HSTS only after HTTPS works; raise its duration gradually.
# DJANGO_HSTS_SECONDS=3600
# Enable subdomains/preload only after every subdomain is HTTPS-ready.
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=1
# DJANGO_HSTS_PRELOAD=1
